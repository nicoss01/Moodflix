[Unit]
Description=MoodFlix Wayland TV kiosk
After=network-online.target moodflix.service systemd-user-sessions.service
Wants=network-online.target
Requires=moodflix.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=__USER__
Group=__USER__
PAMName=login
WorkingDirectory=__APP_DIR__
Environment=HOME=__HOME__
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=XDG_SESSION_TYPE=wayland
Environment=LIBSEAT_BACKEND=logind
Environment=XKB_DEFAULT_LAYOUT=fr
# La télécommande est l'interface du kiosque. Les faux périphériques « souris »
# exposés par HDMI-CEC ne doivent pas empêcher Cage de démarrer sans pointeur.
Environment=WLR_LIBINPUT_NO_DEVICES=1
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/bin/cage -s -- __APP_DIR__/scripts/start-kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
